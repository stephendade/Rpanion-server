#!/bin/sh
set -e

case "$1" in
    configure)
        if ! getent passwd "rpanion" >/dev/null; then
            adduser --system --group --quiet rpanion
        fi

        usermod -a -G plugdev rpanion
        usermod -a -G dialout rpanion
        usermod -a -G netdev rpanion
        usermod -a -G gpio rpanion || true
        usermod -a -G video rpanion
        usermod -a -G adm rpanion    # for systemd journal access
        usermod -a -G render rpanion || true   # for access to hardware video encoding on Jetson Orin
        usermod -a -G networkmanager rpanion || true   # for access to nmcli and dnsmasq leases

        # Set up Python virtual environment
        /usr/share/rpanion-server/app/python/setup-venv.sh

        # Set permissions
        chown -R rpanion /usr/share/rpanion-server
        chown -R rpanion /etc/rpanion-server
        chown -R rpanion /etc/wireguard || true    # wireguard may not be installed yet
        chmod +x /usr/share/rpanion-server/app/server/index.js
        systemctl daemon-reload
        systemctl enable rpanion-server
        systemctl start rpanion-server

        # Allow relevant services to be disabled or enabled without password
        cat <<'EOF' > /etc/sudoers.d/allow-vpn-control
rpanion ALL=(ALL) NOPASSWD: \
  /usr/bin/systemctl disable wg-quick@*, \
  /usr/bin/systemctl enable wg-quick@*, \
  /usr/bin/wg-quick down *, \
  /usr/bin/wg-quick up *, \
  /usr/bin/wg show *, \
  /usr/sbin/zerotier-cli join *, \
  /usr/sbin/zerotier-cli leave *, \
  /usr/sbin/zerotier-cli listnetworks *, \
  /usr/sbin/zerotier-cli info, \
  /usr/sbin/shutdown *, \
  /usr/bin/nmcli *, \
  /usr/sbin/pppd *, \
  /usr/sbin/iw dev * scan ap-force, \
  /usr/bin/pkill -SIGTERM pppd, \
  /usr/bin/cat /var/lib/NetworkManager/dnsmasq-*
EOF

        chmod 440 /etc/sudoers.d/allow-vpn-control
        ;;
esac

exit 0


